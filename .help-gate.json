{
  "build-flags": "enforce",
  "entrypoints": [
    {
      "path": "crates/cv/src/main.rs",
      "version": "semver",
      "subcommands": [
        "daemon",
        "uri",
        "status",
        "signals",
        "media",
        "jobs",
        "intake",
        "run"
      ]
    },
    {
      "path": "crates/editor/src/main.rs",
      "version": "semver",
      "subcommands": [
        "--fake"
      ]
    },
    {
      "path": "docs/spikes/dupes/src/main.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/dupes/Cargo.toml"
    },
    {
      "path": "docs/spikes/postid-dupes/src/main.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/postid-dupes/Cargo.toml"
    },
    {
      "path": "docs/spikes/reading-select/src/main.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/reading-select/Cargo.toml"
    },
    {
      "path": "docs/spikes/search-sidecar/bench/src/main.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/search-sidecar/bench/Cargo.toml"
    },
    {
      "path": "docs/spikes/source-scroll/src/main.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/source-scroll/Cargo.toml"
    },
    {
      "path": "docs/spikes/pdf-render/src/base.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/pdf-render/Cargo.toml"
    },
    {
      "path": "docs/spikes/pdf-render/src/r_hayro.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/pdf-render/Cargo.toml"
    },
    {
      "path": "docs/spikes/pdf-render/src/r_pdfium.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/pdf-render/Cargo.toml"
    },
    {
      "path": "docs/spikes/pdf-render/src/fidelity.rs",
      "build": "cargo build --offline --manifest-path docs/spikes/pdf-render/Cargo.toml"
    }
  ],
  "exclude": []
}
