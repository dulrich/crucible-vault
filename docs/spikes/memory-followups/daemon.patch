@@ -0,0 +1,60 @@
+//! PROTOTYPE (memory-followups WP-1, item 3): kept `Db` caches answer like a fresh host, before
+//! and after an incremental index write within one generation. Run with `CVP_REUSE=1`.
+
+use super::*;
+
+const VIEWS: &str = r##"
+[[views]]
+type = "table"
+name = "K"
+order = ["file.name", "note.k"]
+
+[[views]]
+type = "table"
+name = "J"
+filters = 'note.j != "skip"'
+order = ["file.name", "note.j", "note.k"]
+
+[[views]]
+type = "table"
+name = "All"
+order = ["file.name", "file.properties"]
+"##;
+
+#[test]
+fn kept_caches_match_a_fresh_host_across_a_write() {
+    let tmp = tempfile::tempdir().unwrap();
+    let vault = tmp.path().join("vault");
+    std::fs::create_dir_all(vault.join("n")).unwrap();
+    for i in 0..40 {
+        std::fs::write(
+            vault.join("n").join(format!("{i:02}.md")),
+            format!("---\nk: v{i}\nj: w{i}\nz: {i}\n---\nbody\n"),
+        )
+        .unwrap();
+    }
+    let config = tmp.path().join("config");
+    std::fs::create_dir_all(config.join("views")).unwrap();
+    std::fs::write(config.join("views").join("t.toml"), VIEWS).unwrap();
+    let base = tmp.path().join("idx").join("index.db");
+    std::fs::create_dir_all(base.parent().unwrap()).unwrap();
+    let mut index = cv_index::Index::create(&vault, &base).unwrap();
+    let g = cv_index::Reader::open_current(&base).unwrap().generation();
+    let ids = ["t#K", "t#J", "t#All", "t#K", "t#J"];
+    let mut kept = ViewHost::new(&config, &base);
+    let check = |kept: &mut ViewHost| {
+        for id in ids {
+            let mut fresh = ViewHost::new(&config, &base);
+            let a = grid(&kept.run(g, &RunRequest::view(id)).unwrap());
+            let b = grid(&fresh.run(g, &RunRequest::view(id)).unwrap());
+            assert_eq!(a, b, "{id}");
+        }
+    };
+    check(&mut kept);
+    index
+        .upsert_file("n/03.md", b"---\nk: changed\nj: skip\n---\nbody\n", 1, 1)
+        .unwrap();
+    check(&mut kept);
+    let after = grid(&kept.run(g, &RunRequest::view("t#K")).unwrap());
+    assert!(after.iter().any(|r| r.iter().any(|c| c == "changed")));
+}
