+//! PROTOTYPE knobs (memory-followups WP-1), read once from the environment.
+#![allow(missing_docs)]
+
+use std::sync::OnceLock;
+
+fn flag(cell: &'static OnceLock<bool>, key: &str) -> bool {
+    *cell.get_or_init(|| std::env::var_os(key).is_some())
+}
+
+/// `CVP_DIRECT`: property values decode straight into `views::Value` (item 2).
+pub fn direct() -> bool {
+    static C: OnceLock<bool> = OnceLock::new();
+    flag(&C, "CVP_DIRECT")
+}
+
+/// `CVP_REUSE`: the view host keeps one `Db` cache set across runs (item 3).
+pub fn reuse() -> bool {
+    static C: OnceLock<bool> = OnceLock::new();
+    flag(&C, "CVP_REUSE")
+}
