+++ b/crates/editor/src/me.rs
@@ -0,0 +1,37 @@
+//! Spike instrumentation (memory-followups WP-0; never shipped). Every line is
+//! `CVME <ms since start> <kind> k=v ...` on stderr, only when `CV_ME_PROBE` is set.
+
+use std::sync::OnceLock;
+use std::time::Instant;
+
+static START: OnceLock<Instant> = OnceLock::new();
+static ON: OnceLock<bool> = OnceLock::new();
+
+pub fn on() -> bool {
+    *ON.get_or_init(|| std::env::var_os("CV_ME_PROBE").is_some())
+}
+
+pub fn ms() -> f64 {
+    START.get_or_init(Instant::now).elapsed().as_secs_f64() * 1e3
+}
+
+pub fn knob(name: &str) -> Option<String> {
+    std::env::var(name).ok().filter(|v| !v.is_empty())
+}
+
+pub fn in_use() -> u64 {
+    cv_malloc::info().in_use
+}
+
+pub fn log(kind: &str, fields: std::fmt::Arguments<'_>) {
+    if on() {
+        eprintln!("CVME {:.1} {kind} {fields}", ms());
+    }
+}
+
+/// FNV-1a of a key, so logs carry no paths.
+pub fn h(s: &str) -> u64 {
+    s.bytes().fold(0xcbf2_9ce4_8422_2325_u64, |a, b| {
+        (a ^ u64::from(b)).wrapping_mul(0x0100_0000_01b3)
+    })
+}
