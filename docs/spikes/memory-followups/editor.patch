+        let (svec, _k_svec) = meas("shared_explorer_paths_vec", &mut || {
+            Box::new(table.iter().filter(|(_, p)| super::shown(p)).map(|(_, p)| Arc::clone(p)).collect::<Vec<_>>())
+        });
+        let _files_only = meas("head_explorer_files_only", &mut || {
+            Box::new(rows.iter().filter(|(_, p)| super::shown(p)).map(|(_, p)| p.clone()).collect::<BTreeSet<String>>())
