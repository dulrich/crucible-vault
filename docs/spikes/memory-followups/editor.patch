+/// Spike (memory-followups WP-0): estimated heap of a parsed `Value` (allocation sizes of
+/// strings, vectors and maps; enum slots counted inside their parent).
+fn me_value_bytes(v: &Value) -> usize {
+    const SLOT: usize = std::mem::size_of::<Value>();
+    match v {
+        Value::String(s) => s.capacity(),
+        Value::Array(a) => a.capacity() * SLOT + a.iter().map(me_value_bytes).sum::<usize>(),
+        // BTreeMap node overhead approximated as one key `String` + one `Value` slot + 16 B.
+        Value::Object(m) => m
+            .iter()
+            .map(|(k, x)| 24 + k.capacity() + SLOT + 16 + me_value_bytes(x))
+            .sum(),
+        _ => 0,
+    }
+}
