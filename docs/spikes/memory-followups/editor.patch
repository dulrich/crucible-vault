+/// Spike (memory-followups WP-0, `CV_ME_DECODE_CAP=n`): a counting gate over blocking decodes.
+static ME_GATE: (std::sync::Mutex<usize>, std::sync::Condvar) =
+    (std::sync::Mutex::new(0), std::sync::Condvar::new());
+
+fn me_gate<T>(f: impl FnOnce() -> T) -> T {
+    let cap = crate::me::knob("CV_ME_DECODE_CAP").and_then(|v| v.parse::<usize>().ok());
+    let Some(cap) = cap else { return f() };
+    {
+        let mut n = ME_GATE.0.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        while *n >= cap {
+            n = ME_GATE.1.wait(n).unwrap_or_else(std::sync::PoisonError::into_inner);
+        }
+        *n += 1;
+    }
+    let r = f();
+    *ME_GATE.0.lock().unwrap_or_else(std::sync::PoisonError::into_inner) -= 1;
+    ME_GATE.1.notify_one();
+    r
+}
