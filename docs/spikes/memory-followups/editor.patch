+impl App {
+    /// Spike (memory-followups WP-0): one visibility pass after each update — the Reading-visible
+    /// paths (for `CV_ME_READING`) and the image owners of every non-active note tab (released
+    /// under `CV_ME_HIDE`).
+    fn me_visibility(&mut self) {
+        let hide = crate::me::knob("CV_ME_HIDE");
+        let reading = crate::me::knob("CV_ME_READING");
+        if hide.is_none() && reading.is_none() {
+            return;
+        }
+        let visible: std::collections::HashSet<String> = self
+            .panes
+            .iter()
+            .filter_map(|(_, ps)| ps.active_note(&self.docs))
+            .filter(|t| self.reading.mode(&self.docs, t.path).shows_reading())
+            .map(|t| t.path.to_owned())
+            .collect();
+        if hide.is_some() {
+            let hidden: std::collections::HashSet<String> = self
+                .panes
