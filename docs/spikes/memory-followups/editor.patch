+            Box::new(rows.iter().map(|(i, p)| (p.clone(), *i)).collect::<HashMap<String, i64>>())
+        });
+        let (paths, _k_paths) = meas("resolver_paths_map", &mut || {
+            Box::new(rows.iter().map(|(i, p)| (*i, p.clone())).collect::<HashMap<i64, String>>())
+        });
