+impl ImageCache {
+    /// Spike (memory-followups WP-0, `CV_ME_HIDE`): drops exactly the owners in `hidden` from
+    /// every entry and pending load; unpinned entries go at once (`a`) or stay for LRU (`b`).
+    pub fn me_release_exact(&mut self, hidden: &HashSet<String>) {
+        if hidden.is_empty() {
+            return;
+        }
+        for (k, w) in &mut self.pending {
+            w.retain(|o| !hidden.contains(o));
+            if w.is_empty() {
+                self.reserved.remove(k);
+            }
+        }
+        let mut freed = Vec::new();
+        for (k, e) in &mut self.entries {
+            let n = e.owners.len();
+            e.owners.retain(|o| !hidden.contains(o));
+            if n > 0 && e.owners.is_empty() {
+                freed.push(k.clone());
+            }
+        }
+        if freed.is_empty() {
+            return;
+        }
+        if self.me_keep {
+            self.evict("");
+        } else {
+            for k in freed {
+                self.remove(&k);
+            }
+        }
+    }
