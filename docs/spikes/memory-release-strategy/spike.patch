+//! SPIKE (memory-release-strategy WP-0), throwaway: env-selected glibc knobs, a counting
+//! allocator, malloc_info dumps and a timed, logged release.
+#![allow(unsafe_code, missing_docs, clippy::all)]
+
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::cell::Cell;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+fn env_i32(k: &str) -> Option<i32> {
+    std::env::var(k).ok().and_then(|v| v.parse().ok())
+}
+
+/// CVMR_TRIM_THRESHOLD / CVMR_MMAP_THRESHOLD / CVMR_TOP_PAD / CVMR_ARENA_MAX via mallopt
+/// (applied after tune_daemon's own trim threshold, so they win).
+pub fn apply_env_knobs() {
+    #[cfg(all(target_os = "linux", target_env = "gnu"))]
+    unsafe {
+        if let Some(v) = env_i32("CVMR_TRIM_THRESHOLD") {
+            libc::mallopt(libc::M_TRIM_THRESHOLD, v);
+        }
+        if let Some(v) = env_i32("CVMR_MMAP_THRESHOLD") {
+            libc::mallopt(libc::M_MMAP_THRESHOLD, v);
+        }
+        if let Some(v) = env_i32("CVMR_TOP_PAD") {
+            libc::mallopt(libc::M_TOP_PAD, v);
+        }
+        if let Some(v) = env_i32("CVMR_ARENA_MAX") {
+            libc::mallopt(libc::M_ARENA_MAX, v);
+        }
+    }
+    COUNT.store(std::env::var_os("CVMR_COUNT").is_some(), Relaxed);
+}
+
+static COUNT: AtomicBool = AtomicBool::new(false);
+static TOTAL: AtomicU64 = AtomicU64::new(0);
+thread_local! { static MINE: Cell<u64> = const { Cell::new(0) }; }
+
+pub struct Counting;
+unsafe impl GlobalAlloc for Counting {
+    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+        if COUNT.load(Relaxed) {
+            TOTAL.fetch_add(l.size() as u64, Relaxed);
+            let _ = MINE.try_with(|c| c.set(c.get() + l.size() as u64));
+        }
+        unsafe { System.alloc(l) }
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+        unsafe { System.dealloc(p, l) }
+    }
+    unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
+        if COUNT.load(Relaxed) {
+            TOTAL.fetch_add(l.size() as u64, Relaxed);
+            let _ = MINE.try_with(|c| c.set(c.get() + l.size() as u64));
+        }
+        unsafe { System.alloc_zeroed(l) }
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: Layout, n: usize) -> *mut u8 {
+        if COUNT.load(Relaxed) && n > l.size() {
+            let d = (n - l.size()) as u64;
+            TOTAL.fetch_add(d, Relaxed);
+            let _ = MINE.try_with(|c| c.set(c.get() + d));
+        }
+        unsafe { System.realloc(p, l, n) }
+    }
+}
+
+/// Cumulative bytes allocated, process-wide and on this thread (0 unless CVMR_COUNT).
+pub fn allocated() -> (u64, u64) {
+    (TOTAL.load(Relaxed), MINE.try_with(Cell::get).unwrap_or(0))
+}
+
+/// Writes `malloc_info` XML plus mallinfo2 hblk counts to `path`.
+pub fn dump(path: &str) {
+    #[cfg(all(target_os = "linux", target_env = "gnu"))]
+    unsafe {
+        let Ok(c) = std::ffi::CString::new(path) else { return };
+        let f = libc::fopen(c.as_ptr(), c"w".as_ptr());
+        if f.is_null() {
+            return;
+        }
+        libc::malloc_info(0, f);
+        libc::fclose(f);
+        let m = libc::mallinfo2();
+        let (t, _) = allocated();
+        let _ = std::fs::write(
+            format!("{path}.mallinfo"),
+            format!(
+                "arena={} uord={} ford={} hblks={} hblkhd={} keepcost={} total_alloc={}\n",
+                m.arena, m.uordblks, m.fordblks, m.hblks, m.hblkhd, m.keepcost, t
+            ),
+        );
+    }
+}
+
+fn anon() -> u64 {
+    crate::anon_rss().unwrap_or(0)
+}
+
+/// Threshold-gated (32 MiB free-resident) trim, timed; one `CVMR trim` line on stderr per call
+/// that trims. `force` skips the threshold.
+pub fn timed_release(trigger: &str, force: bool) {
+    let Some(fr) = crate::current_free_resident() else { return };
+    if !force && !crate::over_threshold(fr) {
+        return;
+    }
+    let a0 = anon();
+    let t = Instant::now();
+    let r = crate::trim();
+    let us = t.elapsed().as_micros();
+    let a1 = anon();
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis())
+        .unwrap_or(0);
+    eprintln!(
+        "CVMR trim ts_ms={now} trigger={trigger} us={us} free_res={fr} anon_before={a0} anon_after={a1} released={} ret={r}",
+        a0.saturating_sub(a1)
+    );
+}
