--- /dev/null
+++ b/crates/cv/src/spike.rs
@@ -0,0 +1,83 @@
+//! SPIKE (memory-release-strategy WP-0), throwaway: env-selected release triggers.
+//! CVMR_PERIODIC_SECS=N   trim (gated) every N s on a dedicated thread
+//! CVMR_IDLE_SECS=N       trim (gated) once after N s with no request and no running job
+//! CVMR_AFTER_VIEW=1      trim (gated) on cv-view when its queue is empty after a Cmd::Run
+//! CVMR_AFTER_SEARCH=1    trim (gated) on the blocking pool after each search
+//! CVMR_NO_JOB_TRIM=1     disable the existing after-job trim
+//! CVMR_DIAG_DIR=dir      poll dir/dump.req each 1 s; write dir/<n>.xml (malloc_info) on request
+#![allow(missing_docs, clippy::all)]
+
+use std::sync::atomic::{AtomicI64, AtomicU64, Ordering::Relaxed};
+use std::time::{Duration, Instant};
+
+static START: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+static LAST_ACTIVITY_MS: AtomicU64 = AtomicU64::new(0);
+static JOBS_RUNNING: AtomicI64 = AtomicI64::new(0);
+static ACTIVITY_SEQ: AtomicU64 = AtomicU64::new(0);
+
+fn now_ms() -> u64 {
+    START.get_or_init(Instant::now).elapsed().as_millis() as u64
+}
+fn env_secs(k: &str) -> Option<u64> {
+    std::env::var(k).ok().and_then(|v| v.parse().ok()).filter(|&n| n > 0)
+}
+pub fn flag(k: &str) -> bool {
+    std::env::var_os(k).is_some()
+}
+
+pub fn activity() {
+    LAST_ACTIVITY_MS.store(now_ms(), Relaxed);
+    ACTIVITY_SEQ.fetch_add(1, Relaxed);
+}
+pub fn job_start() {
+    JOBS_RUNNING.fetch_add(1, Relaxed);
+    activity();
+}
+pub fn job_end() {
+    JOBS_RUNNING.fetch_sub(1, Relaxed);
+    activity();
+}
+
+pub fn start() {
+    let _ = now_ms();
+    if let Some(n) = env_secs("CVMR_PERIODIC_SECS") {
+        let _ = std::thread::Builder::new().name("cvmr-periodic".into()).spawn(move || loop {
+            std::thread::sleep(Duration::from_secs(n));
+            cv_malloc::spike::timed_release("periodic", flag("CVMR_FORCE"));
+        });
+    }
+    if let Some(n) = env_secs("CVMR_IDLE_SECS") {
+        let _ = std::thread::Builder::new().name("cvmr-idle".into()).spawn(move || {
+            let mut done_seq = u64::MAX;
+            loop {
+                std::thread::sleep(Duration::from_millis(500));
+                let seq = ACTIVITY_SEQ.load(Relaxed);
+                if seq == done_seq || JOBS_RUNNING.load(Relaxed) > 0 {
+                    continue;
+                }
+                if now_ms().saturating_sub(LAST_ACTIVITY_MS.load(Relaxed)) >= n * 1000 {
+                    cv_malloc::spike::timed_release("idle", false);
+                    done_seq = seq;
+                }
+            }
+        });
+    }
+    if let Ok(dir) = std::env::var("CVMR_DIAG_DIR") {
+        let _ = std::thread::Builder::new().name("cvmr-diag".into()).spawn(move || {
+            let req = format!("{dir}/dump.req");
+            loop {
+                std::thread::sleep(Duration::from_millis(300));
+                if let Ok(name) = std::fs::read_to_string(&req) {
+                    let _ = std::fs::remove_file(&req);
+                    let name = name.trim();
+                    if name == "trim" {
+                        cv_malloc::spike::timed_release("diag", true);
+                    } else {
+                        cv_malloc::spike::dump(&format!("{dir}/{name}.xml"));
+                    }
+                    let _ = std::fs::write(format!("{dir}/{name}.done"), "");
+                }
+            }
+        });
+    }
+}
